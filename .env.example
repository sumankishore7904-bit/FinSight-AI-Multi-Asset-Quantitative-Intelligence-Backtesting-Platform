```env
# FinSight AI Environment Configuration

# Application
APP_NAME=FinSight AI
APP_ENV=development
DEBUG=True

# AI Configuration
OPENAI_API_KEY=your_api_key_here

# Optional AI model configuration
AI_MODEL=gpt-4o-mini

# Financial Data Configuration
DEFAULT_PERIOD=5y

# Risk-free rate used for Sharpe Ratio calculations
RISK_FREE_RATE=0.05

# Annualization settings
MARKET_TRADING_DAYS=252
CRYPTO_TRADING_DAYS=365
```
